# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# Passwords MUST be percent-encoded (e.g. '@' -> %40, '/' -> %2F, ':' -> %3A).
#
# Runtime identity: the least-privilege role `uptimetrace_app` (SELECT + INSERT only).
DATABASE_URL=postgresql://uptimetrace_app:<URL_ENCODED_APP_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Owner identity, used ONLY by `alembic` and `python -m app.provision_app_role`.
# If unset, Alembic falls back to DATABASE_URL (which then needs owner rights).
MIGRATION_DATABASE_URL=postgresql://postgres:<URL_ENCODED_OWNER_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Throwaway local PostgreSQL used ONLY by the automated tests (destructive: tables are truncated).
# The test suite refuses to run if this equals DATABASE_URL or points at supabase.
TEST_DATABASE_URL=postgresql://postgres:<TEST_PASSWORD>@localhost:55432/uptimetrace_test


CLERK_ISSUER=https://close-caiman-7132.clerk.accounts.dev

CLERK_AUTHORIZED_PARTIES=http://localhost:5173

UPTIMETRACE_ALLOWED_USER_IDS=user_3M23mPqgYajO1cyUo63Ju4Htcxi
